Executing (default): SELECT "History"."id", "History"."description", "History"."type", "History"."module", "History"."action", "History"."createdAt", "History"."id_reference", "user"."id" AS "user.id", "user"."full_names" AS "user.full_names", "user"."number_document" AS "user.number_document", "user"."cellphone" AS "user.cellphone", "user"."role" AS "user.role" FROM "histories" AS "History" LEFT OUTER JOIN "users" AS "user" ON "History"."id_user" = "user"."id" WHERE ("History"."id_sucursal" = '1' AND "History"."status" = true AND (EXTRACT(MONTH FROM "History"."createdAt") = 10 AND EXTRACT(YEAR FROM "History"."createdAt") = 2026)) ORDER BY "History"."id" DESC LIMIT 5000 OFFSET 0;
