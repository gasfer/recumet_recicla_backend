    FROM details_transfers dt
    INNER JOIN transfers tr ON tr.id = dt.id_transfer
    LEFT JOIN transfer_review_notes trn
      ON trn.id_transfer = tr.id
      AND trn.id_product = dt.id_product
    WHERE dt.id_product IN (23, 35, 40, 43, 52, 77, 96, 97, 98, 104, 121, 147, 150, 172, 173, 175, 193, 211, 214, 272, 276, 310, 157, 343, 75, 263, 24, 31, 271, 33, 34, 37, 38, 39, 304, 270, 300, 42, 266, 308, 44, 89, 80, 82, 112, 192, 268, 84, 100, 90, 114, 140, 373, 328, 53, 55, 51, 54, 345, 221, 216, 375, 225, 223, 206, 242, 99, 245, 346, 248, 119, 95, 290, 350, 351, 158, 354, 355, 185, 298, 288, 295, 358, 176, 361, 92, 235, 363, 367, 390, 392, 233, 234, 26, 236, 237, 287, 291, 159, 399)
      AND tr.status IN ('PENDING', 'RECEIVED')
